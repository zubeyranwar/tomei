{
  "name": "tomei",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm registry:index && next dev",
    "build": "pnpm registry:build && next build",
    "start": "next start",
    "registry:index": "tsx scripts/registry-index.ts",
    "registry:build": "pnpm registry:index && node -e \"require('fs').rmSync('public/ui/r',{recursive:true,force:true})\" && shadcn build -o public/ui/r",
    "new": "tsx scripts/new-item.ts",
    "lint": "eslint .",
    "typecheck": "pnpm registry:index && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "motion": "^14.7.1",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
