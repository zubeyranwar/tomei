{
  "name": "tomei",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm registry:index && farm dev",
    "build": "pnpm registry:build && farm build",
    "start": "node .farm/.output/server/index.mjs",
    "registry:index": "tsx scripts/registry-index.ts",
    "registry:build": "pnpm registry:index && node -e \"require('fs').rmSync('public/ui/r',{recursive:true,force:true})\" && shadcn build -o public/ui/r",
    "new": "tsx scripts/new-item.ts",
    "lint": "eslint .",
    "typecheck": "pnpm registry:index && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@farm.js/core": "0.1.61",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "lucide-react": "^1.63.0",
    "motion": "^14.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@farm.js/cli": "0.1.61",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
